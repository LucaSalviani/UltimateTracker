/* UltimateTracker — plantilla de estilos. Los @tokens los completa theme::apply()
   según el tema elegido (ver src/ui/Theme.cpp). */

* {
    font-family: "Segoe UI Variable Text", "Segoe UI", "Inter", "Noto Sans", sans-serif;
    font-size: 10pt;
    color: @t1;
}

QWidget#Root, QDialog, QMessageBox {
    background: @bg;
}
QWidget#Root {
    border: 1px solid @s5;
}
QWidget#Root[fullscreen="true"] { border: none; }

QLabel[dim="true"] { color: @t3; }
QLabel[heading="true"] { font-size: 12pt; font-weight: 600; }
QLabel[role="date"] { font-size: 10.5pt; font-weight: 600; padding: 0 2px; }
QLabel[role="clock"] { font-size: 15pt; font-weight: 600; color: @t1; }
QLabel[role="warn"] { color: @accText; }
QLabel[role="toast"] {
    background: @s4;
    border-radius: 8px;
    padding: 6px 12px;
    margin: 0 12px 4px 12px;
    color: @t1;
}

QWidget#DateBand {
    background: @s2;
    border-radius: 8px;
}

QLineEdit {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 3px 6px;
    selection-background-color: @s8;
}
QLineEdit:hover { border-color: @s6; }
QLineEdit:focus { border-color: @s8; background: @bg2; }
QPushButton#BandObjective { background: transparent; border: none; border-radius: 6px; padding: 5px 8px; text-align: left; color: @t1; font-weight: 600; }
QPushButton#BandObjective[empty="true"] { color: @t3; font-weight: 400; }
QPushButton#BandObjective:hover { background: @s4; }

/* ---- Botones ----------------------------------------------------------- */
QToolButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px;
}
QToolButton:hover { background: @s4; }
QToolButton:pressed { background: @s6; }
QToolButton:checked { background: @s6; }
QToolButton[role="close"]:hover { background: @danger; }
QToolButton::menu-indicator { image: none; width: 0; }

QToolButton[role="play"] {
    background: @t1;
    border-radius: 20px;
}
QToolButton[role="play"]:hover { background: @t0; }
QToolButton[role="play"]:pressed { background: @t2; }

QToolButton[role="folder"] {
    background: @s2;
    border-radius: 8px;
    padding: 6px 10px;
    color: @t2;
}
QToolButton[role="folder"]:hover { background: @s4; }

QPushButton {
    background: @s3;
    border: 1px solid @s5;
    border-radius: 8px;
    padding: 6px 14px;
}
QPushButton:hover { background: @s4; }
QPushButton:pressed { background: @s6; }
QPushButton:disabled { color: @s8; }
QPushButton:default { border-color: @s8; }
QPushButton[danger="true"]:hover { background: @dangerBg; border-color: @dangerEdge; }

QPushButton[role="primary"] {
    background: @t1;
    color: @bgx;
    border: none;
    font-weight: 600;
    padding: 8px 18px;
}
QPushButton[role="primary"]:hover { background: @t0; }

QPushButton[role="link"] {
    background: transparent;
    border: none;
    color: @t3;
    padding: 6px 8px;
}
QPushButton[role="link"]:hover { color: @t1; }

QPushButton[role="chip"] {
    background: @s5;
    border: none;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 9pt;
}

QPushButton[segment] {
    border-radius: 0;
    padding: 5px 12px;
    background: @s1;
}
QPushButton[segment="first"] { border-top-left-radius: 8px; border-bottom-left-radius: 8px; }
QPushButton[segment="last"] { border-top-right-radius: 8px; border-bottom-right-radius: 8px; }
QPushButton[segment]:checked { background: @s6; border-color: @s7; }

/* ---- Entradas ---------------------------------------------------------- */
QSpinBox, QComboBox {
    background: @s2;
    border: 1px solid @s5;
    border-radius: 8px;
    padding: 5px 8px;
    min-height: 18px;
}
QSpinBox:hover, QComboBox:hover { border-color: @s7; }
QSpinBox::up-button, QSpinBox::down-button { width: 14px; border: none; background: transparent; }
QSpinBox::up-arrow { width: 7px; height: 7px; }
QSpinBox::down-arrow { width: 7px; height: 7px; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView {
    background: @s2;
    border: 1px solid @s6;
    selection-background-color: @s6;
    outline: none;
}

/* ---- Menús y tooltips --------------------------------------------------- */
QMenu {
    background: @s2;
    border: 1px solid @s6;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item { padding: 6px 22px 6px 14px; border-radius: 5px; }
QMenu::item:selected { background: @s5; }
QMenu::separator { height: 1px; background: @s6; margin: 4px 6px; }
QMenu::indicator { width: 12px; height: 12px; left: 4px; }

QToolTip {
    background: @s3;
    color: @t1;
    border: 1px solid @s7;
    border-radius: 6px;
    padding: 5px 8px;
}

/* ---- Árbol y scroll ---------------------------------------------------- */
QTreeWidget {
    background: @bg2;
    border: 1px solid @s4;
    border-radius: 8px;
    padding: 4px;
    outline: none;
}
QTreeWidget::item { padding: 4px 2px; border-radius: 4px; }
QTreeWidget::item:selected { background: @s5; color: @t0; }
QHeaderView::section {
    background: transparent;
    color: @t3;
    border: none;
    padding: 4px 6px;
}

QScrollArea { background: @bg; border: none; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: @s6; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: @s7; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---- Gestor de actividades -------------------------------------------- */
QTreeWidget#Activities {
    background: transparent;
    border: none;
    padding: 0;
    outline: 0;                    /* sin rectángulo de foco */
    font-size: 10.5pt;
    show-decoration-selected: 1;   /* la fila entera (flecha incluida) es una sola línea */
    selection-background-color: @s4;
}
QTreeWidget#Activities::item {
    padding: 7px 4px;
    border: none;
    border-radius: 0;
}
QTreeWidget#Activities::item:hover { background: @s1; }
QTreeWidget#Activities::item:selected { background: @s4; color: @t0; }
QTreeWidget#Activities QLineEdit {
    background: @bg2;
    border: 1px solid @s8;
    border-radius: 4px;
    padding: 1px 4px;
}
QLineEdit#NewActivity {
    background: @s1;
    border: 1px solid @s4;
    border-radius: 8px;
    padding: 8px 10px;
}
QLineEdit#NewActivity:focus { border-color: @s8; }

QCheckBox { spacing: 8px; }
QCheckBox::indicator {
    width: 16px; height: 16px;
    border: 1px solid @s7;
    border-radius: 4px;
    background: @s2;
}
QCheckBox::indicator:checked { background: @t1; border-color: @t1; image: url(@checkImg); }

/* ---- Reproductor (cronómetro) ----------------------------------------- */
QWidget#Deck {
    background: @bg2;
    border: 1px solid @s4;
    border-radius: 14px;
}
QToolButton#DeckActivity {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 4px 6px;
    color: @t2;
    text-align: left;
}
QToolButton#DeckActivity:hover { background: @s3; }

QToolButton#DeckStep {
    background: @s3;
    border: 1px solid @s5;
    border-radius: 14px;
    min-width: 28px; max-width: 28px;
    min-height: 28px; max-height: 28px;
    font-size: 14pt;
    font-weight: 600;
    color: @t2;
}
QToolButton#DeckStep:hover { background: @s5; }
/* Con números (−5 / +5) el botón se estira un poco */
QToolButton#DeckStep[labeled="true"] { min-width: 36px; max-width: 36px; font-size: 10pt; }
/* Los de afuera, de paso fino: más chicos y discretos */
QToolButton#DeckStep[fine="true"] {
    min-width: 32px; max-width: 32px; min-height: 24px; max-height: 24px;
    border-radius: 12px; font-size: 9pt; color: @t3; background: @s2; border-color: @s4;
}
QToolButton#DeckStep[fine="true"]:hover { background: @s4; color: @t1; }
QLineEdit#DeckEditor {
    background: #101010; color: #f0f0f0;
    border: 1px solid @acc; border-radius: 8px;
    selection-background-color: @accLo; selection-color: #ffffff;
}
QLabel#DeckStepLabel {
    font-family: "Bahnschrift", "Inter", "Segoe UI";
    font-size: 12pt;
    font-weight: 600;
    color: @t1;
}

/* Botón grande: rojo pomodoro / verde agua recreo */
QToolButton#DeckPlay {
    border: none;
    border-radius: 29px;
    background: @acc;
}
QToolButton#DeckPlay:hover { background: @accHi; }
QToolButton#DeckPlay:pressed { background: @accLo; }
QToolButton#DeckPlay[accent="break"] { background: @brk; }
QToolButton#DeckPlay[accent="break"]:hover { background: @brkHi; }
QToolButton#DeckPlay[accent="break"]:pressed { background: @brkLo; }

/* Acción "hefty": Terminar pomodoro / Saltear recreo / Silenciar */
QPushButton#DeckAction {
    background: @s3;
    border: 1px solid @s6;
    border-radius: 12px;
    padding: 11px 14px;
    font-size: 10.5pt;
    font-weight: 700;
    color: @t1;
}
QPushButton#DeckAction:hover { background: @s5; border-color: @acc; }
QPushButton#DeckAction[accent="break"]:hover { border-color: @brk; }
QPushButton#DeckAction:pressed { background: @s3; }

/* ---- Ajustes por secciones ---- */
QListWidget#SettingsNav { background: transparent; border: none; border-right: 1px solid @s4; outline: 0; padding-right: 6px; }
QListWidget#SettingsNav::item { padding: 8px 10px; border-radius: 6px; color: @t3; margin: 1px 0; }
QListWidget#SettingsNav::item:hover { background: @s3; color: @t1; }
QListWidget#SettingsNav::item:selected { background: @s5; color: @t1; }
QToolButton#ThemeChoice { background: @s2; border: 1px solid @s4; border-radius: 8px; padding: 8px 6px 6px 6px; color: @t2; }
QToolButton#ThemeChoice:hover { background: @s4; border-color: @s7; }
QToolButton#ThemeChoice:checked { background: @s5; border: 1px solid @t3; color: @t1; }

/* Nota del pomodoro en el reproductor */
QLineEdit#DeckNote {
    background: @s1; border: 1px solid @s4; border-radius: 8px;
    padding: 6px 9px; color: @t1; font-size: 9.5pt;
}
QLineEdit#DeckNote:focus { border-color: @s8; }

/* ---- Meta del día (panel que sale de la derecha) ---- */
QFrame#GoalPanel { background: @bg2; border-left: 1px solid @s5; }
QScrollArea#GoalScroll, QWidget#GoalContent { background: transparent; }
QLabel[role="caption"] { color: @t3; font-size: 7.5pt; font-weight: 600; letter-spacing: 1px; }
QLineEdit#GoalField { background: @s2; border: 1px solid @s4; border-radius: 7px; padding: 6px 8px; color: @t1; }
QLineEdit#GoalField:focus { border-color: @s8; }
QPushButton#GoalSeg { background: @s2; border: 1px solid @s4; padding: 6px 8px; color: @t3; }
QPushButton#GoalSeg:first { border-top-left-radius: 7px; border-bottom-left-radius: 7px; }
QPushButton#GoalSeg:last { border-top-right-radius: 7px; border-bottom-right-radius: 7px; border-left: none; }
QPushButton#GoalSeg:checked { background: @s6; color: @t1; }
QToolButton#GoalDay { background: @s2; border: 1px solid @s4; border-radius: 13px; min-width: 26px; max-width: 26px; min-height: 26px; max-height: 26px; color: @t3; font-weight: 600; }
QToolButton#GoalDay:checked { background: @t2; color: @bg; border-color: @t2; }
QToolButton#GoalClose { background: transparent; border: none; border-radius: 6px; padding: 4px; }
QToolButton#GoalClose:hover { background: @s4; }
QLabel#GoalStatus { color: @t1; font-weight: 600; }
QPushButton#GoalSave { background: @t1; color: @bg; border: none; border-radius: 8px; padding: 7px 14px; font-weight: 600; }
QPushButton#GoalSave:hover { background: @t0; }
QPushButton#GoalRemove { background: transparent; color: @t3; border: 1px solid @s5; border-radius: 8px; padding: 7px 12px; }
QPushButton#GoalRemove:hover { color: @t1; border-color: @s8; }

/* ---- Saludo al iniciar (M10) ---- */
QLabel#GreetTitle { font-size: 15pt; font-weight: 600; color: @t1; }
QLabel#GreetPhrase { font-size: 10.5pt; color: @t3; font-style: italic; }
QLabel#GreetFacts { font-size: 9pt; color: @t2; }
QPushButton#GreetGo { background: @acc; color: #ffffff; border: none; border-radius: 9px; padding: 9px 20px; font-weight: 600; font-size: 10.5pt; }
QPushButton#GreetGo:hover { background: @accHi; }
QPushButton#GreetLater { background: transparent; color: @t3; border: 1px solid @s5; border-radius: 9px; padding: 9px 16px; }
QPushButton#GreetLater:hover { color: @t1; border-color: @s8; }

/* Objetivo por pomodoros con botones (M17) */
QToolButton#GoalStep { background: @s3; border: 1px solid @s5; border-radius: 12px; min-width: 24px; max-width: 24px; min-height: 24px; max-height: 24px; color: @t2; font-weight: 600; }
QToolButton#GoalStep:hover { background: @s5; color: @t1; }
QLabel#GoalRowValue { color: @t1; font-weight: 600; font-family: "Bahnschrift", "Inter", "Segoe UI"; font-size: 10.5pt; }
QToolButton#GoalRowDelete { background: transparent; border: none; color: @t3; padding: 2px 6px; border-radius: 6px; }
QToolButton#GoalRowDelete:hover { background: @s4; color: @t1; }
QPushButton#GoalAdd { background: transparent; border: 1px dashed @s7; border-radius: 7px; padding: 5px 10px; color: @t2; }
QPushButton#GoalAdd:hover { border-color: @t3; color: @t1; }

/* ---- Mini reproductor (M19) ---- */
QToolButton#MiniPlay { border: none; border-radius: 18px; background: @acc; }
QToolButton#MiniPlay:hover { background: @accHi; }
QToolButton#MiniPlay[accent="break"] { background: @brk; }
QToolButton#MiniPlay[accent="break"]:hover { background: @brkHi; }
QToolButton#MiniAction { border: 1px solid #3a3a3a; border-radius: 14px; background: #202020; }
QToolButton#MiniAction:hover { background: #2c2c2c; }
QToolButton#MiniClose { border: none; border-radius: 9px; background: transparent; }
QToolButton#MiniClose:hover { background: #2c2c2c; }

/* Modo desarrollador (M20) */
QToolButton#DevButton { background: transparent; border: 1px dashed @acc; border-radius: 6px; padding: 1px 5px; }
QToolButton#DevButton:hover { background: @s4; }
